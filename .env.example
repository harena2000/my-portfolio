# Postgres connection string (Neon: copy it from the console → Connect).
# neon.tech URLs connect over WebSockets (port 443) via @neondatabase/serverless.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/neondb?sslmode=require

# Long random string used by Payload to sign auth tokens (e.g. `openssl rand -hex 32`)
PAYLOAD_SECRET=change-me

# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: Vercel Blob token. When unset, uploads are stored on local disk in ./media
BLOB_READ_WRITE_TOKEN=
